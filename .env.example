NEXT_PUBLIC_GOOGLE_ANALYTICS=''
SENTRY_AUTH_TOKEN=

NEXT_PUBLIC_RUN_MODE=''
NEXT_PUBLIC_API_URL_DEV=''
NEXT_PUBLIC_API_URL_PROD=''

# NocoDB self-host base config
NOCODB_BASE_URL=''
NOCODB_API_TOKEN=''

# Dedicated table for Magical Message form
NOCODB_MAGICAL_MESSAGE_TABLE_ID=''

# Dedicated table for Seminar Dosen form
NOCODB_SEMINAR_DOSEN_TABLE_ID=''

# Dedicated table for Seminar Dosen 2 (Juni 2026) form
NOCODB_SEMINAR_DOSEN_2_TABLE_ID=''

# Dedicated table for Seminar Dosen 3 (Oktober 2026) form
NOCODB_SEMINAR_DOSEN_3_TABLE_ID=''

# Optional: batas kuota pendaftaran Seminar Dosen 3 (default 80)
NOCODB_SEMINAR_DOSEN_3_QUOTA='80'

# Dedicated table for Seminar Dosen 4 (iCCom iC-Talk, 11 November 2026) form
NOCODB_SEMINAR_DOSEN_4_TABLE_ID=''

# Optional: constrain insert to a specific NocoDB view (per-table overrides take precedence)
NOCODB_VIEW_ID=''
NOCODB_SEMINAR_DOSEN_2_VIEW_ID=''
NOCODB_SEMINAR_DOSEN_3_VIEW_ID=''
NOCODB_SEMINAR_DOSEN_4_VIEW_ID=''

# Optional: map form fields to your exact NocoDB column names
NOCODB_FIELD_DOA_HARAPAN='doaHarapan'
NOCODB_FIELD_NAMA_PENULIS='namaPenulis'
NOCODB_FIELD_SUBMITTED_AT='submittedAt'

# Optional: override NocoDB column names for Seminar Dosen 2
NOCODB_FIELD_SEMINAR_DOSEN_2_FULL_NAME='fullName'
NOCODB_FIELD_SEMINAR_DOSEN_2_NRP='nrp'
NOCODB_FIELD_SEMINAR_DOSEN_2_ANGKATAN='angkatan'
NOCODB_FIELD_SEMINAR_DOSEN_2_PRODI='prodi'
NOCODB_FIELD_SEMINAR_DOSEN_2_SUBMITTED_AT='submittedAt'

# Optional: override NocoDB column names for Seminar Dosen 3
NOCODB_FIELD_SEMINAR_DOSEN_3_FULL_NAME='fullName'
NOCODB_FIELD_SEMINAR_DOSEN_3_NRP='nrp'
NOCODB_FIELD_SEMINAR_DOSEN_3_ANGKATAN='angkatan'
NOCODB_FIELD_SEMINAR_DOSEN_3_PRODI='prodi'
NOCODB_FIELD_SEMINAR_DOSEN_3_SUBMITTED_AT='submittedAt'

# Optional: override NocoDB column names for Seminar Dosen 4
NOCODB_FIELD_SEMINAR_DOSEN_4_FULL_NAME='fullName'
NOCODB_FIELD_SEMINAR_DOSEN_4_NRP='nrp'
NOCODB_FIELD_SEMINAR_DOSEN_4_ANGKATAN='angkatan'
NOCODB_FIELD_SEMINAR_DOSEN_4_PRODI='prodi'
NOCODB_FIELD_SEMINAR_DOSEN_4_SUBMITTED_AT='submittedAt'

# ----------------------------------------------------------------------------
# HMTC CMS (server-only unless prefixed NEXT_PUBLIC_). See
# docs/hmtc-cms-integration-plan.md §5 and docs/local-development.md.
# ----------------------------------------------------------------------------
# Local: http://localhost:8055 (pnpm directus:setup). Deployed: internal URL if
# the frontend shares a Docker network with Directus, else the public URL.
DIRECTUS_URL=''
# Static token of the read-only "nextjs-reader" user (published revisions only).
DIRECTUS_READ_TOKEN=''
# Shared with the Directus Flow that calls /api/cms/revalidate (HMAC-SHA256).
# Generate with: openssl rand -hex 32
CMS_REVALIDATE_SECRET=''
# Optional cookie domain for cms_at / cms_rt. Empty = host-only (recommended).
CMS_SESSION_COOKIE_DOMAIN=''
# 'false' makes /dashboard/cms read-only (decision N9, staging). Default 'true'.
CMS_EDITING_ENABLED='true'
